# ---- AI (optional) -----------------------------------------------------------
# Leave blank to run in clearly-labelled DEMO MODE with realistic sample replies.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-haiku-5-5)
ANTHROPIC_MODEL=

# ---- Database (optional) -----------------------------------------------------
# Set BOTH to persist leads in Supabase. Leave blank to use a local SQLite file
# (./data/leads.db). Server-only: the service-role key must never be exposed
# to the browser, so do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: custom path for the local SQLite file
SQLITE_PATH=
